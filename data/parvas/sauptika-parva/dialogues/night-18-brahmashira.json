    },
    {
      "dialogue_id": "sp_krishna_warning",
      "speaker_id": "krishna",
      "dialogue_text": "Partha! He has unleashed the ultimate fire. If it strikes, all creation burns. You must counter it with your own Brahmashira!",
      "speaker_emotion": "ANGRY",
      "camera_focus_target": "PORTRAIT_ONLY",
      "choices": [
        {
          "choice_id": "sp_c1",
          "choice_text": "[Invoke the Brahmashira to counter his.]",
          "dharma_impact": 10,
          "next_dialogue_id": "sp_vyasa_intervenes",
