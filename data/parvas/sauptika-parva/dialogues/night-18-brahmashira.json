        }
      ]
    },
    {
      "dialogue_id": "sp_vyasa_intervenes",
      "speaker_id": "vyasa",
      "dialogue_text": "Stop! Fools! If two Brahmashiras collide, the region will suffer drought for twelve years! Withdraw your weapons immediately!",
      "speaker_emotion": "ENLIGHTENED",
      "camera_focus_target": "PORTRAIT_ONLY",
      "next_dialogue_id": "sp_arjuna_withdraws"
    },
    {
      "dialogue_id": "sp_arjuna_withdraws",
      "speaker_id": "arjuna",
      "dialogue_text": "I withdraw my weapon, O Sage, for the sake of the world.",
