{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lore Schema",
  "type": "object",
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/character"
      }
    },
    "lore": {
      "type": "object",
      "properties": {
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/trait"
          }
        },
        "auras": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/aura"
          }
        },
        "vows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/vow"
          }
        },
        "boons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/boon"
          }
        }
      },
      "required": ["traits", "auras", "vows", "boons"]
    },
    "unit_classes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unit_class"
      }
    }
  },
  "required": ["characters", "lore", "unit_classes"],
  "additionalProperties": false
},
"definitions": {
  "character": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "faction": { "type": "string" },
      "sprite_key": { "type": "string" },
      "traits": {
        "type": "array",
        "items": { "type": "string" }
      },
      "auras": {
        "type": "array",
        "items": { "type": "string" }
      },
      "vows": {
        "type": "array",
        "items": { "type": "string" }
      },
      "boons": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["id", "name", "faction", "sprite_key", "traits", "auras", "vows", "boons"],
    "additionalProperties": false
  },
  "trait": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "applies_to": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["id", "name", "description", "applies_to"],
    "additionalProperties": false
  },
  "aura": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "dharma_cost": { "type": "integer", "minimum": 0 },
      "restrictions": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["id", "name", "description", "dharma_cost", "restrictions"],
    "additionalProperties": false
  },
  "vow": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "condition": { "type": "string" },
      "effect": { "type": "string" }
    },
    "required": ["id", "name", "description", "condition", "effect"],
    "additionalProperties": false
  },
  "boon": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "effect": { "type": "string" }
    },
    "required": ["id", "name", "description", "effect"],
    "additionalProperties": false
  },
  "unit_class": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "base_hp": { "type": "integer", "minimum": 0 },
      "base_attack": { "type": "integer", "minimum": 0 },
      "base_defense": { "type": "integer", "minimum": 0 },
      "allowed_auras": {
        "type": "array",
        "items": { "type": "string" }
      },
      "restrictions": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["id", "name", "base_hp", "base_attack", "base_defense", "allowed_auras", "restrictions"],
    "additionalProperties": false
  }
}