{
  "type": "object",
  "properties": {
    "timeline_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the timeline node"
          },
          "description": {
            "type": "string",
            "description": "Description of the timeline event or battle phase"
          },
          "fail_on_deviation": {
            "type": "boolean",
            "description": "If true, failing a directive triggers canonical rewind via associated dialogue"
          },
          "directives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the directive"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the directive objective"
                },
                "fail_on_deviation": {
                  "type": "boolean",
                  "description": "If true, failure triggers canonical rewind"
                }
              },
              "required": ["id", "description"]
            }
          }
        },
        "required": ["id", "description", "fail_on_deviation", "directives"]
      }
    },
    "canonical_directives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the canonical directive"
          },
          "description": {
            "type": "string",
            "description": "Description of the canonical objective"
          },
          "fail_on_deviation": {
            "type": "boolean",
            "description": "If true, failing this directive triggers canonical rewind"
          }
        },
        "required": ["id", "description", "fail_on_deviation"]
      }
    }
  },
  "required": ["timeline_nodes", "canonical_directives"]
}