{
  "type": "object",
  "properties": {
    "dialogue_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the dialogue node"
          },
          "text": {
            "type": "string",
            "description": "The text content of the dialogue node"
          },
          "speaker": {
            "type": "string",
            "description": "The speaker of the dialogue (must match a character ID from global/characters.json)"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the choice"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the choice"
                },
                "impacts": {
                  "type": "object",
                  "properties": {
                    "dharma_impact": {
                      "type": "integer",
                      "description": "Impact on Dharma (moral duty/righteousness)"
                    },
                    "artha_impact": {
                      "type": "integer",
                      "description": "Impact on material prosperity/wealth"
                    },
                    "kama_impact": {
                      "type": "integer",
                      "description": "Impact on desire/pleasure"
                    },
                    "moksha_impact": {
                      "type": "integer",
                      "description": "Impact on spiritual liberation"
                    }
                  },
                  "required": ["dharma_impact", "artha_impact", "kama_impact", "moksha_impact"]
                },
                "next_node_id": {
                  "type": "string",
                  "description": "ID of the next dialogue node after this choice"
                }
              },
              "required": ["id", "description", "impacts", "next_node_id"]
            }
          }
        },
        "required": ["id", "text", "speaker", "choices"]
      }
    },
    "narrative_choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the narrative choice"
          },
          "description": {
            "type": "string",
            "description": "Description of the narrative choice"
          },
          "impacts": {
            "type": "object",
            "properties": {
              "dharma_impact": {
                "type": "integer",
                "description": "Impact on Dharma (moral duty/righteousness)"
              },
              "artha_impact": {
                "type": "integer",
                "description": "Impact on material prosperity/wealth"
              },
              "kama_impact": {
                "type": "integer",
                "description": "Impact on desire/pleasure"
              },
              "moksha_impact": {
                "type": "integer",
                "description": "Impact on spiritual liberation"
              }
            },
            "required": ["dharma_impact", "artha_impact", "kama_impact", "moksha_impact"]
          },
          "next_node_id": {
            "type": "string",
            "description": "ID of the next narrative node after this choice"
          }
        },
        "required": ["id", "description", "impacts", "next_node_id"]
      }
    }
  },
  "required": ["dialogue_nodes", "narrative_choices"]
}